# Server Configuration
PORT=5000
NODE_ENV=production

# Database - REQUIRED
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Authentication - REQUIRED
SESSION_SECRET=your-session-secret-key-here-at-least-32-characters
JWT_SECRET=your-jwt-secret-key-here-at-least-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Optional - if using Google login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-app.onrender.com/api/v1/auth/google/callback

# Email Configuration (Optional - if sending emails)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Frontend URL for CORS (Optional)
FRONTEND_URL=https://your-frontend-url.com

# PayOS Configuration (Optional - if using payment)
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Gemini AI (Optional - if using AI features)
GEMINI_API_KEY=your-gemini-api-key

# ZEGO Cloud (Optional - if using video calls)
ZEGO_APP_ID=your-zego-app-id
ZEGO_SERVER_SECRET=your-zego-server-secret
